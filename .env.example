# OCI user-principal authentication reads the key referenced by this config.
OCI_REGION=us-chicago-1
OCI_MODEL=your-supported-model-id
# responses (default) or langchain_oci; shared by Demo01 and Demo02.
OCI_MODEL_INTERFACE=responses
# Required for responses only.
OCI_PROJECT_ID=ocid1.generativeaiproject.oc1.your-region.your-project
# Required for langchain_oci only. For example, use OCI_MODEL=cohere.command-a-03-2025.
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..your-compartment
# Dedicated endpoints only: set OCI_MODEL to the endpoint OCID and this to its model ID.
# OCI_MODEL_NAME=cohere.command-a-03-2025
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
OCI_TIMEOUT_SECONDS=120
OCI_MAX_OUTPUT_TOKENS=2048

# Full pause between consecutive calls, including after failed calls.
EVAL_SLEEP_SECONDS=2

LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=your-public-key
LANGFUSE_SECRET_KEY=your-secret-key
